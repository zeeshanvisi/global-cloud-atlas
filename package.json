{
  "name": "hyperscalar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "ingest:aws": "node scripts/ingest/aws.mjs",
    "ingest:azure": "node scripts/ingest/azure.mjs",
    "ingest:gcp": "node --env-file-if-exists=.env scripts/ingest/gcp.mjs",
    "data:build": "node scripts/build-data.mjs",
    "ingest": "node scripts/ingest/aws.mjs && node scripts/ingest/azure.mjs && node --env-file-if-exists=.env scripts/ingest/gcp.mjs && node --env-file-if-exists=.env scripts/ingest/discounts.mjs && node scripts/build-data.mjs",
    "ingest:discounts": "node --env-file-if-exists=.env scripts/ingest/discounts.mjs",
    "deploy:api": "python3 -I scripts/deploy/api_push.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.4.0"
  }
}
